# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# Supabase — Settings → API in your project dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never NEXT_PUBLIC_

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile
# Dev test keys below always pass — replace with real keys before deploy
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional — Upstash Redis rate limiting (free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
